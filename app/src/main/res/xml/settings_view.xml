<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Connection Settings">
        <EditTextPreference
            android:defaultValue=""
            android:inputType="textUri"
            android:key="webview_url"
            android:title="ImmichFrame Server URL" />
        <EditTextPreference
            android:defaultValue=""
            android:key="authSecret"
            android:title="Authorization Secret" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="allowCleartext"
            android:summary="Only enable for a trusted LAN; HTTP exposes photos and credentials"
            android:title="Allow insecure HTTP server" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Display Options">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="useWebView"
            android:summary="Not recommended on old dedicated frames such as WF1561"
            android:title="Use WebView?" />
        <ListPreference
            android:defaultValue="THUMBHASH"
            android:entries="@array/frame_background_entries"
            android:entryValues="@array/frame_background_values"
            android:key="frameBackground"
            android:summary="%s"
            android:title="Unused-space background" />
        <ListPreference
            android:defaultValue="FIT"
            android:entries="@array/frame_scale_entries"
            android:entryValues="@array/frame_scale_values"
            android:key="frameScale"
            android:summary="%s"
            android:title="Photo scaling" />
        <SeekBarPreference
            android:defaultValue="6"
            android:key="splitGapDp"
            android:max="32"
            android:min="0"
            app:showSeekBarValue="true"
            android:title="Split-view gap (dp)" />
        <SeekBarPreference
            android:defaultValue="0"
            android:key="overlayFadeSeconds"
            android:max="120"
            android:min="0"
            app:showSeekBarValue="true"
            android:title="Fade photo metadata after seconds (0 = never)" />
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="burnInEnabled"
            android:title="Move overlays to reduce burn-in" />
        <SeekBarPreference
            android:defaultValue="40"
            android:key="clockSizeSp"
            android:max="64"
            android:min="24"
            app:showSeekBarValue="true"
            android:title="Clock size (sp)" />
        <SeekBarPreference
            android:defaultValue="24"
            android:key="metadataSizeSp"
            android:max="36"
            android:min="12"
            app:showSeekBarValue="true"
            android:title="Photo date/location size (sp)" />
        <SeekBarPreference
            android:defaultValue="96"
            android:key="overlayScrimAlpha"
            android:max="220"
            android:min="0"
            app:showSeekBarValue="true"
            android:title="Overlay background strength" />
        <SeekBarPreference
            android:defaultValue="24"
            android:key="safeMarginDp"
            android:max="48"
            android:min="8"
            app:showSeekBarValue="true"
            android:title="Overlay safe margin (dp)" />
        <SeekBarPreference
            android:defaultValue="32"
            android:key="edgeFeatherDp"
            android:max="64"
            android:min="0"
            app:showSeekBarValue="true"
            android:title="Photo edge blend (dp)" />
        <SeekBarPreference
            android:defaultValue="16"
            android:key="backgroundBlurRadius"
            android:max="24"
            android:min="0"
            app:showSeekBarValue="true"
            android:title="Background blur strength" />
        <SeekBarPreference
            android:defaultValue="84"
            android:key="backgroundDarkness"
            android:max="200"
            android:min="0"
            app:showSeekBarValue="true"
            android:title="Background darkness" />
        <SeekBarPreference
            android:defaultValue="30"
            android:key="zoomFrameRate"
            android:max="60"
            android:min="10"
            app:showSeekBarValue="true"
            android:title="Ken Burns zoom frame rate" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="showCurrentDate"
            android:title="Show Current Date?" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="settingsLock"
            android:title="Lock access to these settings?" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Authenticated Remote Control">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="rpcEnabled"
            android:title="Enable LAN RPC server" />
        <EditTextPreference
            android:dependency="rpcEnabled"
            android:defaultValue=""
            android:key="rpcToken"
            android:summary="Required as an Authorization: Bearer token"
            android:title="RPC access token" />
    </PreferenceCategory>

    <PreferenceCategory android:title="MQTT / Home Assistant">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="mqttEnabled"
            android:summary="Publish controls and status using Home Assistant MQTT Discovery"
            android:title="Enable MQTT" />
        <EditTextPreference
            android:dependency="mqttEnabled"
            android:defaultValue=""
            android:inputType="textUri"
            android:key="mqttBrokerUri"
            android:summary="For example tcp://192.168.1.10:1883 or ssl://broker:8883"
            android:title="MQTT broker URI" />
        <EditTextPreference
            android:dependency="mqttEnabled"
            android:defaultValue=""
            android:key="mqttUsername"
            android:title="MQTT username" />
        <EditTextPreference
            android:dependency="mqttEnabled"
            android:defaultValue=""
            android:key="mqttPassword"
            android:title="MQTT password" />
        <Preference
            android:key="mqttDeviceIdDisplay"
            android:selectable="false"
            android:title="MQTT device ID" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Active Times">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="activeTimes"
            android:title="Set Active Hours?" />
        <Preference
            android:dependency="activeTimes"
            android:key="active_schedule_edit"
            android:summary="Per-weekday on/off times"
            android:title="Edit Active Schedule" />
        <Preference
            android:dependency="activeTimes"
            android:key="active_schedule_admin"
            android:summary="Allow the frame to turn off the screen and sleep the device during inactive hours"
            android:title="Enable Screen-Off Permission" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Android Settings">
        <Preference
            android:defaultValue=""
            android:key="androidSettings"
            android:title="Launch Android Settings" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Interactions">
        <Preference
            android:key="interactions"
            android:selectable="false"
            android:summary="⬆️ Open Settings\n🆗 Play/Pause\n⬅️ Previous Image\n➡️ Next Image\n👇 Open Settings (swipe)" />
    </PreferenceCategory>

    <Preference
        android:key="closeSettings"
        android:layout="@layout/pref_close_button" />
</PreferenceScreen>
